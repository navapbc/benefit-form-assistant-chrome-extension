{
  "name": "nava-form-filling-assistant-chrome-extension",
  "version": "0.16.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Local-first Chrome side-panel prototype for Nava's form-completion protocol.",
  "scripts": {
    "check": "node scripts/check-syntax.mjs",
    "lint": "eslint .",
    "check:vendor": "node scripts/verify-vendor.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "check:modules": "node scripts/check-modules.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:package": "node scripts/package-extension.mjs",
    "connector:mock": "node --env-file-if-exists=.env.local connector-service/mock-server.mjs",
    "connector:migrate": "node --env-file-if-exists=.env.local connector-service/migrate.mjs",
    "model:bridge": "node model-bridge/server.mjs",
    "model:jev": "node model-bridge/start-jev.mjs",
    "model:smoke": "node scripts/smoke-subscription-planner.mjs",
    "ocr:fixtures": "node scripts/generate-ocr-fixtures.mjs",
    "ocr:assets": "node scripts/vendor-ocr-assets.mjs",
    "eval:extraction": "node scripts/run-extraction-eval.mjs",
    "eval:models": "node scripts/summarize-model-evaluation.mjs",
    "test": "node --test tests/*.test.cjs",
    "model:eve": "npm --prefix model-bridge/eve run dev",
    "eval:captcha": "node scripts/summarize-captcha-metrics.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "package": "node scripts/package-extension.mjs --build"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "fflate": "^0.8.3",
    "globals": "^16.5.0",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.1",
    "tesseract.js": "^7.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@neon/functions": "^0.11.0",
    "hono": "^4.13.13",
    "jose": "^6.2.13"
  }
}
