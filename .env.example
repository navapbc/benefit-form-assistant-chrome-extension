# Copy to .env.local (gitignored) and fill in your own values. Names only: never commit real values.
# Used by the local tooling, not by the extension itself.

# Neon Postgres, for connector-service (mock store) and participant-api. Pooled and direct (unpooled) connection strings.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# participant-api: Neon Auth endpoints, the https origin it signs in from, and the chrome-extension:// origins allowed to call it
# (comma-separated; pin your extension ID with a manifest "key" so it is stable).
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
AUTH_ORIGIN=
ALLOWED_ORIGINS=

# connector-service mock: origins allowed to write (leave unset to refuse browser writes).
MOCK_WRITE_ORIGINS=

# model-bridge companion: pairing token (random one is generated when unset), port and provider.
NAVA_MODEL_BRIDGE_TOKEN=
NAVA_MODEL_BRIDGE_PORT=
NAVA_MODEL_PROVIDER=

# Optional Jev / TypeSafe access for the Jev planner.
TYPESAFE_API_KEY=
JEV_API_KEY=
